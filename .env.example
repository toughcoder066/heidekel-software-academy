# =============================================================================
# HEIDEKEL SOFTWARE ACADEMY - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================

# Application URL (used for redirects and emails)
VITE_APP_URL=http://localhost:5173

# =============================================================================
# PAYSTACK PAYMENT INTEGRATION
# =============================================================================

# Paystack Public Key (from Dashboard > Settings > API Keys)
# Test keys start with pk_test_, live keys start with pk_live_
# This key is SAFE to expose in frontend code
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack Secret Key (from Dashboard > Settings > API Keys)
# ⚠️  NEVER expose this in frontend code
# ⚠️  Only use in server-side code (API routes, webhooks)
# In Next.js, use PAYSTACK_SECRET_KEY (without VITE_ prefix)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack Webhook URL
# Set this in your Paystack Dashboard > Settings > Preferences > Webhooks
# Example: https://your-domain.com/api/webhooks/paystack
PAYSTACK_WEBHOOK_URL=https://your-domain.com/api/webhooks/paystack

# =============================================================================
# SUPABASE (Database & Authentication)
# =============================================================================

# Supabase Project URL (from Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (from Dashboard > Settings > API)
# This key is SAFE to expose in frontend code
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (from Dashboard > Settings > API)
# ⚠️  NEVER expose this in frontend code
# ⚠️  Only use in server-side code for admin operations
# In Next.js, use SUPABASE_SERVICE_ROLE_KEY (without VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# RESEND (Transactional Email)
# =============================================================================

# Resend API Key (from https://resend.com/api-keys)
# ⚠️  NEVER expose this in frontend code
# In Next.js, use RESEND_API_KEY (without VITE_ prefix)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender email address (must be verified in Resend)
# Example: noreply@heidekel.com
RESEND_FROM_EMAIL=noreply@your-domain.com

# =============================================================================
# OPTIONAL: ANALYTICS & MONITORING
# =============================================================================

# Vercel Analytics (automatically configured on Vercel)
# VERCEL_ANALYTICS_ID=

# Sentry DSN for error tracking (optional)
# VITE_SENTRY_DSN=

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 
# 1. Paystack Setup:
#    - Create account at https://dashboard.paystack.com
#    - Get API keys from Settings > API Keys
#    - Use TEST keys for development (pk_test_, sk_test_)
#    - Use LIVE keys for production (pk_live_, sk_live_)
#    - Configure webhook URL in Settings > Preferences > Webhooks
#    - Webhook endpoint: POST /api/webhooks/paystack
#
# 2. Supabase Setup:
#    - Create project at https://supabase.com
#    - Get URL and keys from Settings > API
#    - Run database migrations: supabase db push
#    - Enable RLS on all tables
#    - Configure auth settings in Authentication > Providers
#
# 3. Resend Setup:
#    - Create account at https://resend.com
#    - Verify your domain
#    - Get API key from API Keys section
#    - Free tier: 100 emails/day, 3,000 emails/month
#
# 4. Security:
#    - Never commit .env.local to git
#    - Use different keys for development and production
#    - Rotate keys if accidentally exposed
#    - Use Vercel environment variables for production
#
# 5. Testing Payments:
#    - Use Paystack test cards: https://paystack.com/docs/payments/test-payments
#    - Test MoMo numbers: 0500000000 (MTN), 0200000000 (Vodafone)
#    - Test bank accounts available in Paystack dashboard
#
# =============================================================================
