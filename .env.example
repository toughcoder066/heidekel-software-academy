# =============================================================================
# HEIDEKEL SOFTWARE ACADEMY - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# =============================================================================

# =============================================================================
# SUPABASE (Required)
# =============================================================================
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API

# Supabase Project URL
# Example: https://abcdefghijk.supabase.co
VITE_SUPABASE_URL=

# Supabase Anon/Public Key (safe to expose in frontend)
# This key is used for client-side operations with RLS enforcement
VITE_SUPABASE_ANON_KEY=

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
# This key bypasses RLS - use only in API routes/server-side code
# Required for: webhook handlers, admin operations, email sending
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# PAYSTACK (Required for payments)
# =============================================================================
# Get these from: https://dashboard.paystack.com → Settings → API Keys

# Paystack Public Key (safe to expose in frontend)
# Test keys start with pk_test_, live keys start with pk_live_
VITE_PAYSTACK_PUBLIC_KEY=

# Paystack Secret Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
# Required for: webhook verification, transaction verification
PAYSTACK_SECRET_KEY=

# Paystack Webhook URL (configure in Paystack Dashboard)
# Example: https://your-domain.com/api/webhooks/paystack
# Events to subscribe: charge.success, charge.failed
PAYSTACK_WEBHOOK_URL=

# =============================================================================
# RESEND (Optional - for transactional emails)
# =============================================================================
# Get API key from: https://resend.com/api-keys

# Resend API Key (SERVER-SIDE ONLY)
# Free tier: 100 emails/day, 3,000 emails/month
RESEND_API_KEY=

# Verified sender email (must be verified in Resend dashboard)
# Example: noreply@heidekel.com
RESEND_FROM_EMAIL=

# =============================================================================
# APPLICATION
# =============================================================================

# Application URL (used for redirects and emails)
# Development: http://localhost:5173
# Production: https://your-domain.com
VITE_APP_URL=http://localhost:5173

# Node environment
NODE_ENV=development

# =============================================================================
# OPTIONAL: ANALYTICS & MONITORING
# =============================================================================

# Vercel Analytics (automatically configured on Vercel)
# VERCEL_ANALYTICS_ID=

# Sentry DSN for error tracking (optional)
# VITE_SENTRY_DSN=

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. SUPABASE SETUP:
#    a. Create account at https://supabase.com
#    b. Create new project
#    c. Run migrations: supabase db push (or manual SQL in dashboard)
#    d. Get URL and keys from Settings → API
#    e. Configure auth: Authentication → Providers → Email
#    f. Set Site URL in Authentication → URL Configuration
#
# 2. PAYSTACK SETUP:
#    a. Create account at https://dashboard.paystack.com
#    b. Get API keys from Settings → API Keys
#    c. Use TEST keys for development (pk_test_, sk_test_)
#    d. Use LIVE keys for production (pk_live_, sk_live_)
#    e. Configure webhook in Settings → Preferences → Webhooks
#    f. Webhook endpoint: POST /api/webhooks/paystack (implement in Next.js)
#
# 3. RESEND SETUP (Optional):
#    a. Create account at https://resend.com
#    b. Verify your domain
#    c. Get API key from API Keys section
#
# 4. CREATE FIRST ADMIN:
#    a. Sign up via the app with your email
#    b. Go to Supabase Dashboard → Table Editor → profiles
#    c. Change your role from 'student' to 'admin'
#    d. Or run SQL: UPDATE profiles SET role = 'admin' WHERE email = 'your@email.com';
#
# 5. SECURITY NOTES:
#    - Never commit .env.local to git
#    - Use different keys for development and production
#    - Rotate keys if accidentally exposed
#    - VITE_* variables are exposed to browser (use only for anon/public keys)
#    - Variables without VITE_ prefix are server-side only
#
# 6. TESTING PAYMENTS:
#    - Use Paystack test cards: https://paystack.com/docs/payments/test-payments
#    - Test MoMo numbers: 0500000000 (MTN), 0200000000 (Vodafone)
#    - Test bank accounts available in Paystack dashboard
#    - Webhooks work in test mode - configure test webhook URL
#
# =============================================================================
